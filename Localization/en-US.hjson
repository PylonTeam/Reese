Mods: {
	Reese: {
		Keybinds.ReplayUI.DisplayName: Open Replay UI

		Configs: {
			ClientConfig: {
				DisplayName: Client Config

				Headers: {
					MainMenu: Main Menu
					Debug: Debug
					Replay: Replay
				}

				AddExtraMenuState: {
					Label: Show [c/5ad2ff:Reese] Button
					Tooltip: Adds the [c/5ad2ff:Reese] button that opens a state with the replay browser
				}

				ShowInMainMenu: {
					Label: Show Replay Browser In Main Menu
					Tooltip: Always show the replay browser in main menu
				}

				ShowWelcomeMessageOnEnterWorld: {
					Label: Show Welcome Message On Enter World
					Tooltip: ""
				}

				AutoStartRecordingOnEnterWorld: {
					Label: Auto Start Recording On Enter World
					Tooltip: When disabled, recordings only start when the record console command is used.
				}

				MaxRecordingLengthMinutes: {
					Label: Max Recording Length Minutes
					Tooltip: Maximum replay recording length in minutes. Set to 0 to allow recordings to continue without stopping.
				}

				AutoStartRecordingAfterMaxLength: {
					Label: Auto Start Recording After Max Length
					Tooltip: When enabled, Reese starts a new recording part after a recording reaches the configured maximum length.
				}

				BaselineIntervalTicks: {
					Label: Baseline Interval Ticks
					Tooltip: How often Reese writes replay baseline checkpoints, in ticks. 60 ticks is about 1 second. Set to 0 to disable baselines. Max: 216000 ticks (1 hour).
				}

				SeekMaxMillisecondsPerFrame: {
					Label: Seek Milliseconds Per Frame
					Tooltip: Maximum milliseconds Reese spends per frame catching up during seeking. Higher values make seeking faster but may briefly freeze the game.
				}

				ShowDebugMessages: {
					Label: Show Debug Messages
					Tooltip: For developers and testers
				}

				ShowDebugDrawer: {
					Label: Show Debug Drawer
					Tooltip: For developer use only, draws debug stats in the top left corner in-game.
				}

				EnableBackwardsSeeking: {
					Label: Enable Backwards Seeking (experimental)
					Tooltip: ""
				}
			}
		}

		Items: {
			CameraItem: {
				DisplayName: Camera Item
				Tooltip: ""
			}

			GhostItem: {
				DisplayName: Ghost Item
				Tooltip: ""
			}

			SmallCameraItem: {
				DisplayName: Small Camera Item
				Tooltip: ""
			}
		}
	}
}

Configs: {
	ClientConfig: {
		DisplayName: Client Config

		Headers: {
			MainMenu: Main Menu
			Replay: Replay
			Debug: Debug
		}

		AddExtraMenuState: {
			Label: Show Reese Button
			Tooltip: Adds the Reese button that opens the replay browser from the main menu.
		}

		ShowWelcomeMessageOnEnterWorld: {
			Label: Show Replay Welcome Message
			Tooltip: ""
		}

		TryLoadModsUsedInReplay: {
			Label: Try Load Mods Used In Replay
			Tooltip:
				'''
				When enabled, Reese tries to load the embedded mods recorded with a replay before playback.
				When disabled, Reese force-loads the replay with your current mods even if they do not match.
				'''
		}

		SeekMaxMillisecondsPerFrame: {
			Label: Seek Milliseconds Per Frame
			Tooltip:
				'''
				Maximum milliseconds Reese spends per frame catching up during seeking.
				Higher values make seeking faster but may briefly freeze the game.
				'''
		}

		ShowDebugMessages: {
			Label: Show Debug Messages
			Tooltip: Shows extra chat messages for developers and testers.
		}
	}

	ServerConfig: {
		DisplayName: Server Config

		Headers: {
			Recording: Recording
			Spectating: Spectating
		}

		BaselineIntervalSeconds: {
			Label: Baseline Interval Seconds
			Tooltip:
				'''
				How often Reese writes replay baseline checkpoints.
				Shorter values makes replay seeking faster, but increases file size quickly.
				Larger values keep file size small, but makes replay seeking slower.
				'''
		}

		CaptureModsUsedInReplay: {
			Label: Capture Mods Used In Replay
			Tooltip:
				'''
				Embeds loaded .tmod files in new replays so Reese can try to load the exact replay mod set later.
				Disable this to keep replay files smaller; replay metadata will still list mod names.
				'''
		}

		ghostSpectatingConfig: {
			Label: Ghost Spectating
			Tooltip: ""
		}

		AutoStartRecordingOnEnterWorld: {
			Label: Auto Start Recording On Enter World
			Tooltip: ""
		}

		AutoStartRecordingWhenPlayersAreInWorld: {
			Label: Auto Start Recording When Players Are In World
			Tooltip: ""
		}

		maxLengthRecordingConfig: {
			Label: Max Length
			Tooltip: ""
		}
	}

	GhostSpectatingConfig: {
		IsGhostSpectatingEnabled: {
			Label: Enable Ghost Spectating
			Tooltip: Whether ghosts have the same spectating features as a replay
		}

		ForceSpectateWhenJoining: {
			Label: Force Spectate When Joining
			Tooltip: Makes everyone who joins a ghost automatically
		}

		DrawGhosts: {
			Label: Draw Ghosts
			Tooltip: Whether players can see other ghosts' sprites
		}

		DrawGhostsNameplates: {
			Label: Draw Ghost Nameplates
			Tooltip: Whether players can see other ghosts' nameplates
		}

		ShowSpectatorJoinPanel: {
			Label: Show Spectator Join Panel
			Tooltip: Let players pick player or spectator when entering the world
		}

		Tooltip: ""
	}

	MaxLengthRecordingConfig: {
		Tooltip: ""

		EnableMaxLengthRecording: {
			Label: Enable Max Length Recording
			Tooltip: Whether to limit recordings to a configured max length.
		}

		MaxRecordingLengthMinutes: {
			Label: Max Recording Length Minutes
			Tooltip: The configured max length.
		}

		AutoStartRecordingAfterMaxLength: {
			Label: Auto Start Recording After Max Length
			Tooltip: Starts a new recording after it reaches the configured max length.
		}
	}
}


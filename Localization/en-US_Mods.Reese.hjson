ServerStartedSsl: Starting server...
Keybinds.ReplayUI.DisplayName: Open Replay UI

MainMenu: {
	ReplayBrowser: {
		EnterReplayName: Enter Replay Name
		ReeseButton: Reese Replays
		Date: Date
		Length: Length
		Refresh: Refresh

		ReplayUnavailable: {
			InvalidMetadata: Replay metadata is invalid or incomplete.
			ModMismatchHeader: "[c/ffcc66:Mod mismatch]"
			ModMismatchDescription: This replay was recorded with different mods than you have enabled.
			MissingMods: Missing mods ({0}):
			MissingModEntry: "[mi:{0}][c/ff5555:{0} (enable)]"
			ExtraMods: Extra enabled mods ({0}):
			ExtraModEntry: "[mi:{0}][c/1ec2ff:{0} (disable)]"
		}
	}

	ReplayStartup: {
		Reading: Reading {0}...
		Connecting: Connecting...
		ConnectingWithCurrentMods: Connecting with current mods...
		FailedToStart: Failed to start replay
		NotFound: Replay not found
		NotFoundOrNull: Replay {0} not found or null
		PreparingMods: Preparing replay mods for {0}...
		FailedToPrepareMods: Failed to prepare replay mods
		RestoringPreviousMods: Restoring previous mods...
		FailedToRestorePreviousMods: Failed to restore previous mods
		ModVerificationFailed: Replay mod verification failed: {0}
		ForceLoadTimedOut: Replay launch timed out after {0} seconds while force-loading with your current mods.
		ForceLoadFailed: Replay launch failed before entering the replay world while force-loading with your current mods.
		ModMismatch: Mod mismatch: {0}.
		ForceLoadAdvice: Enable Try Load Mods Used In Replay or enable the replay's mods, then try again.
	}
}

Recorder: {
	ThisWorldIsBeingRecordedWithReese: This world is being recorded with Reese!

	Status: {
		Active: Recording to "{0}" | Length: {1} | Packets: {2} | Size: {3} KB
		Inactive: Recording is not running. Last recording: "{0}" | Final Tick: {1}
		NotInitialized: Recorder has not been initialized yet.
	}
}

Replayer.ReplayWelcomeMessage:
	'''
	Welcome to your Reese replay! Now playing: [c/FFFFFF:{0}]
	Quick guide:
	Top HUD: spectate players/NPCs
	Bottom HUD: playback controls
	Right side HUD: settings
	Right click to teleport around the world.
	To toggle the entire replay HUD, assign a keybind in controls.
	Enjoy!
	'''

ReplayHud: {
	Common.Kilobytes: "{0} KB"

	Playback: {
		Title: Replay
		GoToStart: Go to start
		NextFrame: Next Frame
		SeekBackwardSeconds: -{0} Seconds
		SeekForwardSeconds: +{0} Seconds
